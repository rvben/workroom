{
  "name": "workroom",
  "version": "0.1.0",
  "private": true,
  "description": "A local workspace for Jira, GitLab, ServiceNow, Outlook and coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rvben/workroom.git"
  },
  "homepage": "https://github.com/rvben/workroom#readme",
  "bugs": "https://github.com/rvben/workroom/issues",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts --production",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "agent": "node --import tsx server/cli.ts",
    "check:public": "node scripts/check-public.mjs --history",
    "smoke:release": "node scripts/smoke-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
